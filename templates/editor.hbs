<div class="bhe-editor-body">
  <p class="bhe-editor-help">{{localize "BHE.Editor.Help"}}</p>
  <div class="bhe-editor-grid">
    {{#each pages}}
    <div class="bhe-editor-page" data-page="{{page}}">
      <span class="bhe-editor-page-number" data-tooltip="BHE.Editor.Page" aria-hidden="true">{{page}}</span>
      {{#if rowTwo}}<i class="bhe-row-two fa-solid fa-eye" data-tooltip-text="{{@root.rowTwoText}}" aria-label="{{@root.rowTwoText}}"></i>
      {{else}}<span class="bhe-row-two" aria-hidden="true"></span>{{/if}}
      <div class="bhe-editor-slots" role="group" aria-label="{{localize "BHE.Editor.PageLabel" page=page}}">
        {{#each slots}}
        <div class="slot {{cssClass}}{{#if hidden}} hidden-from-user{{/if}}" data-action="slot" data-slot="{{slot}}"
             data-macro-id="{{macroId}}" role="button" tabindex="0" aria-label="{{label}}"
             {{#if name}}data-tooltip-text="{{tooltip}}" draggable="true"{{/if}}>
          {{#if img}}<img class="slot-icon" src="{{img}}" alt="">{{/if}}
          <span class="key" aria-hidden="true">{{key}}</span>
          {{#if hidden}}<i class="bhe-hidden-mark fa-solid fa-eye-slash" aria-hidden="true"></i>{{/if}}
          {{#if @root.canCreate}}{{#unless name}}<button type="button" class="bhe-new" data-action="newMacro" tabindex="-1"
            data-tooltip="BHE.Editor.New" aria-label="{{localize "BHE.Editor.New"}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/unless}}{{/if}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/each}}
  </div>
</div>
